# TELEGRAM_API_ID / TELEGRAM_API_HASH
#   https://my.telegram.org -> log in -> "API development tools" -> create an app
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TELEGRAM_SESSION_STRING - the grader's logged-in user account
#   run `python3 login.py` (asks for your phone + the code Telegram texts you);
#   it prints the session string to paste here
TELEGRAM_SESSION_STRING=

# BOT_TOKEN -  message @BotFather -> /newbot -> copy the token it gives you
BOT_TOKEN=

# AIPROXY_TOKEN or OPENAI_API_KEY
AIPROXY_TOKEN=
OPENAI_API_KEY=

# Public URL of your VM for serving the log file
PUBLIC_URL=http://YOUR_VM_IP:8000
